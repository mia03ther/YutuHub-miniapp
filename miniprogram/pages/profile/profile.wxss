.profile {
  padding-bottom: 160rpx;
}

.profile-head {
  position: relative;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.profile-top {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.avatar-img,
.avatar-fallback {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand);
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-level {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  padding: 0 14rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 17rpx;
  background: var(--ink-900);
  border: 3rpx solid #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  color: #FFB07A;
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.profile-name-line {
  display: flex;
  align-items: center;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-verify {
  margin-left: 12rpx;
  flex-shrink: 0;
  height: 36rpx;
  padding: 0 14rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  font-size: 19rpx;
}

.profile-school {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-500);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-sign {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-400);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.profile-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.5rpx;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-400);
}

.bind {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: var(--surface-sunken);
  border: 1rpx solid var(--line);
}

.bind-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.bind-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-500);
}

.bind-form {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.bind-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  border-radius: 28rpx;
  background: #FFFFFF;
  line-height: 1;
  overflow: hidden;
}

.bind-avatar::after {
  border: none;
}

.bind-avatar-ph {
  font-size: 22rpx;
  color: var(--ink-300);
}

.bind-avatar-img {
  width: 100rpx;
  height: 100rpx;
}

.bind-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin-left: 18rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  font-size: 26rpx;
  color: var(--ink-900);
}

.bind-input-ph {
  color: var(--ink-300);
  font-size: 24rpx;
}

.bind-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.publish {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.publish-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--brand-soft);
}

.publish-icon-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
}

.publish-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.publish-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.publish-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-500);
  line-height: 1.4;
}

.publish-cta {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 56rpx;
}

.menus {
  overflow: hidden;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.menu-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 24rpx;
}

.menu-item + .menu-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 100rpx;
  right: 0;
  height: 1rpx;
  background: var(--line);
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: var(--surface-sunken);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-700);
}

.menu-icon--purple {
  background: #F0F0FF;
  color: #6C5CE7;
}

.menu-icon--orange {
  background: #FFF1ED;
  color: #FF6B4A;
}

.menu-icon--blue {
  background: #EFF5FF;
  color: #3D8BFF;
}

.menu-icon--pink {
  background: #FFF0F3;
  color: #FF5C8A;
}

.menu-icon--mint {
  background: #EDFBF6;
  color: #16C79A;
}

.menu-label {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  font-size: 28rpx;
  color: var(--ink-900);
}

.menu-value {
  margin-right: 12rpx;
  font-size: 24rpx;
  color: var(--ink-300);
}

.menu-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--ink-300);
  border-right: 3rpx solid var(--ink-300);
  transform: rotate(45deg);
}

.logout {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  font-size: 28rpx;
  font-weight: 500;
  color: #E5534B;
}

.version {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-300);
}
