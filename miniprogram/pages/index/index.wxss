.container {
  min-height:100vh;
  background:#f7f8fa;
  padding:30rpx;
}


/* 顶部 */

.hero {

  background:linear-gradient(
    135deg,
    #667eea,
    #764ba2
  );

  padding:50rpx 40rpx;

  border-radius:32rpx;

  color:white;

}


.title {

  font-size:56rpx;

  font-weight:700;

}


.subtitle {

  margin-top:15rpx;

  font-size:28rpx;

  opacity:.9;

}



.hero-tags {

  display:flex;

  flex-wrap:wrap;

  margin-top:35rpx;

}


.hero-tags text {

  background:rgba(255,255,255,.2);

  padding:10rpx 18rpx;

  border-radius:30rpx;

  margin-right:15rpx;

  margin-bottom:15rpx;

  font-size:24rpx;

}



/* 搜索 */

.search-box {

  margin-top:30rpx;

  background:white;

  height:90rpx;

  border-radius:45rpx;

  display:flex;

  align-items:center;

  padding:0 30rpx;

  color:#999;

}


.search-icon {

  margin-right:20rpx;

}


/* section */

.section {

 margin-top:40rpx;

}


.section-title {

 font-size:36rpx;

 font-weight:700;

}



.grid {

 display:grid;

 grid-template-columns:repeat(4,1fr);

 gap:20rpx;

 margin-top:25rpx;

}


.card {

 background:white;

 height:160rpx;

 border-radius:25rpx;

 display:flex;

 flex-direction:column;

 align-items:center;

 justify-content:center;

 font-size:26rpx;

}


.icon {

 font-size:50rpx;

 margin-bottom:15rpx;

}



/* 动态 */


.section-header {

 display:flex;

 justify-content:space-between;

}


.more {

 color:#888;

}



.post {

 margin-top:25rpx;

 background:white;

 padding:30rpx;

 border-radius:25rpx;

 display:flex;

}


.avatar {

 font-size:50rpx;

 margin-right:25rpx;

}


.post-title {

 font-size:32rpx;

 font-weight:bold;

}


.desc {

 color:#666;

 margin-top:12rpx;

}


.meta {

 color:#aaa;

 margin-top:15rpx;

 font-size:24rpx;

}



/* 商业 */


.business {

 margin-top:50rpx;

 background:#111;

 color:white;

 padding:35rpx;

 border-radius:30rpx;

}


.business-title {

 font-size:38rpx;

 font-weight:bold;

}


.business-desc {

 margin-top:15rpx;

 opacity:.8;

}