.index {
  padding-bottom: 160rpx;
}

.nav-action {
  display: flex;
  align-items: center;
}

.nav-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--surface-sunken);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-500);
}

.header {
  margin-top: 8rpx;
  padding: 0 4rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.6rpx;
  line-height: 1.2;
}

.header-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink-500);
  line-height: 1.4;
}

.search {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-ring {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid var(--ink-400);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-stick {
  position: absolute;
  right: 4rpx;
  bottom: 2rpx;
  width: 10rpx;
  height: 4rpx;
  border-radius: 3rpx;
  background: var(--ink-400);
  transform: rotate(45deg);
}

.search-placeholder {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--ink-300);
}

.features {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.feature-item {
  width: 160rpx;
  margin-bottom: 20rpx;
}

.feature-press {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.feature-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--surface-sunken);
}

.feature-icon-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-700);
}

.feature-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-900);
  text-align: center;
}

.skeleton-row {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
}

.skeleton-avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
}

.skeleton-lines {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.skeleton-line {
  height: 22rpx;
  margin-bottom: 12rpx;
  border-radius: 11rpx;
  background: #F0F0EC;
}

.skeleton-line--sm {
  width: 40%;
  height: 18rpx;
}

.skeleton-line--lg {
  width: 70%;
  margin-bottom: 0;
}

.skeleton-block {
  height: 160rpx;
  margin: 20rpx 24rpx 24rpx;
  border-radius: 20rpx;
  background: #F0F0EC;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.state-icon {
  font-size: 72rpx;
  line-height: 1;
}

.state-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-400);
  text-align: center;
}

.state-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 32rpx;
  padding: 0 40rpx;
  border-radius: 20rpx;
  background: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.feed {
  display: flex;
  flex-direction: column;
}

.feed-item {
  margin-bottom: 20rpx;
}

.feed-card {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
}

.feed-head {
  display: flex;
  align-items: center;
}

.feed-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.feed-avatar--purple {
  background: linear-gradient(135deg, #6C5CE7, #8B7BFF);
}

.feed-avatar--orange {
  background: linear-gradient(135deg, #FF7A45, #FFA56B);
}

.feed-avatar--blue {
  background: linear-gradient(135deg, #3D8BFF, #7BB4FF);
}

.feed-avatar--mint {
  background: linear-gradient(135deg, #16C79A, #5FE3C0);
}

.feed-avatar--pink {
  background: linear-gradient(135deg, #FF5C8A, #FF93B4);
}

.feed-meta {
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
}

.feed-author-line {
  display: flex;
  align-items: center;
}

.feed-author {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-900);
  margin-right: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.feed-channel-pill {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: var(--surface-sunken);
  color: var(--ink-500);
  font-size: 20rpx;
  font-weight: 600;
}

.feed-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-300);
}

.feed-title {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.4rpx;
  line-height: 1.4;
}

.feed-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink-500);
  line-height: 1.6;
}

.feed-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.feed-tags {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.feed-tag {
  margin-right: 12rpx;
  font-size: 22rpx;
  color: var(--ink-500);
  white-space: nowrap;
}

.feed-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.feed-action {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.feed-action-icon {
  font-size: 24rpx;
  line-height: 1;
  color: var(--ink-400);
}

.feed-action-icon.is-liked {
  color: var(--brand);
}

.feed-action-num {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--ink-400);
}

.group-tabs {
  display: flex;
  align-items: center;
  padding: 4rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.group-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-400);
}

.group-tab--active {
  color: #FFFFFF;
  background: var(--brand);
}

.recommend {
  display: flex;
  flex-direction: column;
}

.recommend-item {
  margin-bottom: 16rpx;
}

.recommend-card {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
}

.recommend-top {
  display: flex;
  flex-direction: column;
}

.recommend-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.4;
}

.recommend-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-500);
  line-height: 1.45;
}

.recommend-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.recommend-meta {
  font-size: 22rpx;
  color: var(--ink-300);
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
}

.footer-line {
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--line-strong);
}

.footer-text {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--ink-300);
}
