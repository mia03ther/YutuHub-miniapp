.explore {
  padding-bottom: 160rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin-top: 8rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.search-ring {
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid var(--ink-400);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-stick {
  position: absolute;
  right: 4rpx;
  bottom: 2rpx;
  width: 10rpx;
  height: 4rpx;
  border-radius: 3rpx;
  background: var(--ink-400);
  transform: rotate(45deg);
}

.search-placeholder {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--ink-300);
}

.channels {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.channel-item {
  width: 322rpx;
  margin-bottom: 20rpx;
}

.channel-press {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
}

.channel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.channel-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--surface-sunken);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-700);
  line-height: 1;
}

.channel-title {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.4rpx;
}

.channel-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-500);
  line-height: 1.4;
}

.channel-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.channel-tag {
  margin: 0 10rpx 10rpx 0;
  padding: 0 14rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  background: var(--surface-sunken);
  font-size: 20rpx;
  color: var(--ink-500);
}

.topic-scroll {
  width: 100%;
  margin: 0 -32rpx;
}

.topic-row {
  display: flex;
  padding: 4rpx 32rpx;
}

.topic {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 26rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--ink-500);
}

.topic--active {
  background: var(--brand);
  border-color: var(--brand);
  color: #FFFFFF;
  font-weight: 600;
}

.chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 10rpx;
  border-top: 3rpx solid var(--ink-300);
  border-right: 3rpx solid var(--ink-300);
  transform: rotate(45deg);
}

.picks {
  display: flex;
  flex-direction: column;
}

.pick-item {
  margin-bottom: 16rpx;
}

.pick-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx;
}

.pick-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--surface-sunken);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink-700);
}

.pick-icon-wrap--purple {
  background: #F0F0FF;
  color: #6C5CE7;
}

.pick-icon-wrap--orange {
  background: #FFF1ED;
  color: #FF6B4A;
}

.pick-icon-wrap--blue {
  background: #EFF5FF;
  color: #3D8BFF;
}

.pick-icon-wrap--mint {
  background: #EDFBF6;
  color: #16C79A;
}

.pick-icon-wrap--pink {
  background: #FFF0F3;
  color: #FF5C8A;
}

.pick-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.pick-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-900);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pick-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-400);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.follow {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
}

.discussions {
  display: flex;
  flex-direction: column;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 40rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.state-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.state-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--ink-400);
  text-align: center;
}

.state-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  margin-top: 28rpx;
  padding: 0 40rpx;
  border-radius: 20rpx;
  background: var(--brand);
  font-size: 25rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.skeleton-discussion-avatar {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
}

.skeleton-line {
  height: 22rpx;
  margin-bottom: 12rpx;
  border-radius: 11rpx;
  background: #F0F0EC;
}

.skeleton-line--sm {
  width: 40%;
  height: 18rpx;
}

.skeleton-line--lg {
  width: 75%;
  margin-bottom: 0;
}

.discussion-item {
  margin-bottom: 16rpx;
}

.discussion {
  display: flex;
}

.discussion-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.discussion-avatar--purple {
  background: linear-gradient(135deg, #6C5CE7, #8B7BFF);
}

.discussion-avatar--orange {
  background: linear-gradient(135deg, #FF7A45, #FFA56B);
}

.discussion-avatar--blue {
  background: linear-gradient(135deg, #3D8BFF, #7BB4FF);
}

.discussion-avatar--mint {
  background: linear-gradient(135deg, #16C79A, #5FE3C0);
}

.discussion-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.discussion-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.discussion-author {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.discussion-time {
  font-size: 21rpx;
  color: var(--ink-300);
}

.discussion-title {
  display: block;
  margin-top: 8rpx;
  font-size: 27rpx;
  color: var(--ink-700);
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.discussion-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.discussion-channel {
  font-size: 20rpx;
  color: var(--brand);
}

.discussion-meta {
  font-size: 20rpx;
  color: var(--ink-300);
}
