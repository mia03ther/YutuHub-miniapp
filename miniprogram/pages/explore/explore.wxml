<view class="page explore">
  <navbar title="发现" subtitle="找到你的同频频道" logoText="探" bordered="{{false}}" />

  <view class="search pressable" bindtap="onSearchTap">
    <view class="search-icon">
      <view class="search-ring"></view>
      <view class="search-stick"></view>
    </view>
    <text class="search-placeholder">搜索频道、话题、同学</text>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">精选频道</text>
        <text class="section-desc">四大场景，随时开聊</text>
      </view>
    </view>

    <view class="channels">
      <view wx:for="{{channels}}" wx:key="key" class="channel-item">
        <view class="channel-press pressable" data-title="{{item.title}}" bindtap="onChannelTap">
          <view class="channel-top">
            <view class="channel-icon-wrap">{{item.icon}}</view>
          </view>
          <text class="channel-title">{{item.title}}</text>
          <text class="channel-desc">{{item.desc}}</text>
          <view class="channel-tags">
            <text wx:for="{{item.topics}}" wx:for-item="tag" wx:key="*this" class="channel-tag">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">热门话题</text>
        <text class="section-desc">按热度实时更新</text>
      </view>
    </view>

    <scroll-view
      class="topic-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{activeTopicId}}"
      scroll-with-animation="{{true}}"
    >
      <view class="topic-row">
        <view
          wx:for="{{topics}}"
          wx:key="*this"
          id="topic-{{item}}"
          class="topic {{activeTopic === item ? 'topic--active' : ''}} pressable"
          data-topic="{{item}}"
          bindtap="onTopicTap"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">编辑精选</text>
        <text class="section-desc">本周同学收藏最多</text>
      </view>
      <view class="section-action" bindtap="onPickTap">
        <text>更多</text>
        <view class="chevron"></view>
      </view>
    </view>

    <view class="picks">
      <view wx:for="{{picks}}" wx:key="id" class="pick-item">
        <view class="pick-card pressable" bindtap="onPickTap">
          <view class="pick-icon-wrap pick-icon-wrap--{{item.tone}}">{{item.meta[0]}}</view>
          <view class="pick-body">
            <text class="pick-title">{{item.title}}</text>
            <text class="pick-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <text class="section-title">最新讨论</text>
        <text class="section-desc">来自 {{activeTopic}} 频道</text>
      </view>
      <view class="follow pressable" bindtap="onToggleFollow">
        <text>{{following ? '已关注' : '+ 关注'}}</text>
      </view>
    </view>

    <block wx:if="{{loading}}">
      <view class="discussion-item">
        <view class="feed-card">
          <view class="skeleton-row">
            <view class="skeleton skeleton-avatar"></view>
            <view class="skeleton skeleton-lines">
              <view class="skeleton skeleton-line skeleton-line--sm"></view>
              <view class="skeleton skeleton-line skeleton-line--lg"></view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view wx:elif="{{error}}" class="state">
      <text class="state-title">加载失败</text>
      <text class="state-desc">{{error}}</text>
      <view class="state-btn pressable" bindtap="onRetry">
        <text>重新加载</text>
      </view>
    </view>

    <view wx:elif="{{!feed.length}}" class="state">
      <text class="state-title">该频道还没有讨论</text>
      <text class="state-desc">来发第一条，让圈子热起来</text>
    </view>

    <view wx:else class="discussions">
      <view wx:for="{{feed}}" wx:key="id" class="discussion-item">
        <view class="feed-card pressable" data-detail="{{item.detailId}}" bindtap="onFeedTap">
          <view class="discussion">
            <view class="discussion-avatar discussion-avatar--{{item.avatarTone}}">{{item.avatar}}</view>
            <view class="discussion-body">
              <view class="discussion-head">
                <text class="discussion-author">{{item.author}}</text>
                <text class="discussion-time">{{item.time}}</text>
              </view>
              <text class="discussion-title">{{item.title}}</text>
              <view class="discussion-foot">
                <text class="discussion-channel">{{item.channel}}</text>
                <text class="discussion-meta">◧ {{item.comments}} · ♡ {{item.likes}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
