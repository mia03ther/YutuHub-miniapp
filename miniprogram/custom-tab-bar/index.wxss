:host {
  display: block;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx calc(14rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 28rpx rgba(20, 19, 31, 0.06);
}

.tabbar-list {
  display: flex;
  align-items: center;
  height: 104rpx;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #A5A1B8;
}

.tab--hover {
  opacity: 0.7;
}

.tab--active {
  color: #6C5CE7;
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.ico {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
}

.ico-home .ico-roof {
  position: absolute;
  top: 8rpx;
  left: 9rpx;
  width: 0;
  height: 0;
  border-left: 13rpx solid transparent;
  border-right: 13rpx solid transparent;
  border-bottom: 15rpx solid currentColor;
}

.ico-home .ico-body {
  position: absolute;
  top: 22rpx;
  left: 10rpx;
  width: 24rpx;
  height: 16rpx;
  border-radius: 5rpx 5rpx 4rpx 4rpx;
  background: currentColor;
}

.ico-compass {
  border: 5rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.ico-compass .ico-needle {
  position: absolute;
  top: 7rpx;
  left: 50%;
  width: 6rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: currentColor;
  transform: translateX(-50%) rotate(35deg);
}

.ico-user .ico-head {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.ico-user .ico-torso {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  width: 30rpx;
  height: 17rpx;
  border-radius: 16rpx 16rpx 6rpx 6rpx;
  background: currentColor;
  transform: translateX(-50%);
}