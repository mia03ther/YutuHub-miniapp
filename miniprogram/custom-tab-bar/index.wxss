:host {
  display: block;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 0 24rpx calc(14rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid var(--line);
}

.tabbar-list {
  display: flex;
  align-items: center;
  height: 96rpx;
}

.tab {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--ink-400);
}

.tab--hover {
  opacity: 0.7;
}

.tab--active {
  color: var(--brand);
}

.tab-indicator {
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--brand);
  opacity: 0;
  transform: translateX(-50%) scaleX(0.4);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.tab-indicator--on {
  width: 24rpx;
  opacity: 1;
  transform: translateX(-50%) scaleX(1);
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  transition: transform 0.2s ease;
}

.tab--active .tab-icon {
  transform: translateY(-2rpx) scale(1.06);
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
}

.ico {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.ico-home .ico-roof {
  position: absolute;
  top: 8rpx;
  left: 9rpx;
  width: 0;
  height: 0;
  border-left: 13rpx solid transparent;
  border-right: 13rpx solid transparent;
  border-bottom: 15rpx solid currentColor;
}

.ico-home .ico-body {
  position: absolute;
  top: 22rpx;
  left: 10rpx;
  width: 24rpx;
  height: 16rpx;
  border-radius: 5rpx 5rpx 4rpx 4rpx;
  background: currentColor;
}

.ico-compass {
  border: 5rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.ico-compass .ico-needle {
  position: absolute;
  top: 7rpx;
  left: 50%;
  width: 6rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: currentColor;
  transform: translateX(-50%) rotate(35deg);
}

.ico-plus .ico-plus-line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 22rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.ico-plus .ico-plus-v {
  transform: translate(-50%, -50%) rotate(90deg);
}

.ico-user .ico-head {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translateX(-50%);
}

.ico-user .ico-torso {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  width: 30rpx;
  height: 17rpx;
  border-radius: 16rpx 16rpx 6rpx 6rpx;
  background: currentColor;
  transform: translateX(-50%);
}
