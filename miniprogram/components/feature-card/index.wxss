:host {
  display: block;
}

.feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  box-sizing: border-box;
}

.feature--wide {
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
}

.feature-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--surface-sunken);
  font-size: 40rpx;
  line-height: 1;
}

.feature-icon--lg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  font-size: 44rpx;
}

.feature-icon--purple {
  background: #F0F0FF;
}

.feature-icon--orange {
  background: #FFF1ED;
}

.feature-icon--mint {
  background: #EDFBF6;
}

.feature-icon--pink {
  background: #FFF0F3;
}

.feature-icon--blue {
  background: #EFF5FF;
}

.feature-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  padding: 0 12rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 15rpx;
  background: var(--brand);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
}

.feature-body {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature--wide .feature-body {
  margin-top: 0;
  margin-left: 22rpx;
  align-items: flex-start;
  flex: 1;
}

.feature-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-900);
  letter-spacing: -0.2rpx;
  text-align: center;
}

.feature--wide .feature-title {
  font-size: 30rpx;
  text-align: left;
}

.feature-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-400);
  line-height: 1.4;
  text-align: center;
}

.feature--wide .feature-desc {
  text-align: left;
}

.feature-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
}

.arrow-line {
  width: 20rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--ink-300);
}

.arrow-head {
  width: 12rpx;
  height: 12rpx;
  margin-left: -3rpx;
  border-top: 3rpx solid var(--ink-300);
  border-right: 3rpx solid var(--ink-300);
  transform: rotate(45deg);
}
