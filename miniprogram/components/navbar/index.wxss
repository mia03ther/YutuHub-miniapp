:host {
  display: block;
}

.navbar {
  width: 100%;
  background: #FFFFFF;
  z-index: 100;
}

.navbar--sticky {
  position: sticky;
  top: 0;
}

.navbar--bordered {
  border-bottom: 1rpx solid var(--line);
}

.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 22rpx 32rpx;
}

.navbar-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: var(--surface-sunken);
}

.navbar-back--hover {
  opacity: 0.7;
}

.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid var(--ink-900);
  border-left: 4rpx solid var(--ink-900);
  transform: rotate(-45deg);
}

.navbar-brand {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.navbar-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--brand);
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

.navbar-text {
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.navbar-text--solo {
  margin-left: 0;
  flex: 1;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.navbar-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-400);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.navbar-extra {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}
