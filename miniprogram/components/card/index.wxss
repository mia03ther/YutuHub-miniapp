:host {
  display: block;
}

.card {
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.card--plain {
  background: #FFFFFF;
}

.card--flat {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.card--sunken {
  background: var(--surface-sunken);
}

.card--glass {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.card--r-none {
  border-radius: 0;
}

.card--r-sm {
  border-radius: 12rpx;
}

.card--r-md {
  border-radius: 16rpx;
}

.card--r-lg {
  border-radius: 20rpx;
}

.card--r-xl {
  border-radius: 24rpx;
}

.card--r-pill {
  border-radius: 999rpx;
}

.card--p-none {
  padding: 0;
}

.card--p-sm {
  padding: 16rpx;
}

.card--p-md {
  padding: 24rpx;
}

.card--p-lg {
  padding: 32rpx;
}

.card--pressable {
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.card--pressable:active {
  transform: scale(0.975);
  opacity: 0.9;
}
