.page.report {
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
}

.report-head {
  margin-bottom: 36rpx;
}

.report-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink-900);
}

.report-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-400);
  line-height: 1.6;
}

.report-section {
  margin-bottom: 36rpx;
}

.report-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-700);
  margin-bottom: 16rpx;
}

.report-options {
  display: flex;
  flex-wrap: wrap;
}

.report-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 32rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  font-size: 25rpx;
  color: var(--ink-500);
}

.report-option--on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
}

.report-check {
  font-size: 22rpx;
  font-weight: 700;
}

.report-input {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--line);
  background: var(--surface);
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-900);
}

.report-ph {
  color: var(--ink-300);
}

.report-count {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--ink-300);
  text-align: right;
}

.report-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background: var(--brand);
  font-size: 29rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.report-submit--busy {
  opacity: 0.7;
}