.page.legal {
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
}

.legal-head {
  margin-bottom: 24rpx;
}

.legal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-900);
  letter-spacing: -0.5rpx;
}

.legal-updated {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-400);
}

.legal-intro {
  padding: 24rpx;
  border-radius: var(--radius-lg);
  background: var(--brand-soft);
  margin-bottom: 32rpx;
}

.legal-intro-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-700);
}

.legal-block {
  margin-bottom: 36rpx;
}

.legal-block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
  margin-bottom: 14rpx;
}

.legal-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-500);
  margin-bottom: 10rpx;
}

.legal-foot {
  margin-top: 48rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}

.legal-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: var(--radius-lg);
  background: var(--brand);
  font-size: 27rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.legal-foot-text {
  display: block;
  font-size: 22rpx;
  color: var(--ink-400);
  text-align: center;
}