page {
  --brand: #5B4BFF;
  --brand-soft: #EFEEFF;
  --ink-900: #0D0D0D;
  --ink-700: #3A3A3A;
  --ink-500: #6B6B6B;
  --ink-400: #9A9A9A;
  --ink-300: #B5B5B5;
  --line: #E8E8E5;
  --line-strong: #DEDED9;
  --surface: #FFFFFF;
  --surface-sunken: #F7F7F5;
  --surface-hover: #EFEFED;
  --radius-xl: 24rpx;
  --radius-lg: 20rpx;
  --radius-md: 16rpx;
  --radius-sm: 12rpx;
  --shadow-float: 0 12rpx 32rpx rgba(13, 13, 13, 0.08);
  --shadow-subtle: 0 4rpx 16rpx rgba(13, 13, 13, 0.04);

  background: var(--surface-sunken);
  color: var(--ink-900);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 48rpx;
}

.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--ink-900);
}

.section-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-400);
}

.section-action {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--ink-500);
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
}

.pressable {
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.pressable:active {
  transform: scale(0.975);
  opacity: 0.88;
}

.divider {
  height: 1rpx;
  background: var(--line);
}

.skeleton {
  background: #F0F0EC;
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

@keyframes skeleton-shine {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 10rpx;
  border-top: 3rpx solid var(--ink-300);
  border-right: 3rpx solid var(--ink-300);
  transform: rotate(45deg);
}

/* Shared state block: loading failure and empty results. */
.state {
  padding: 64rpx 32rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.state-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-400);
}

.state-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-top: 28rpx;
  padding: 0 40rpx;
  border-radius: 32rpx;
  border: 1rpx solid var(--line-strong);
  font-size: 25rpx;
  color: var(--ink-700);
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
}

.footer-text {
  font-size: 21rpx;
  color: var(--ink-300);
}